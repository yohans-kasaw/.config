{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "autoupdate": false,
  "lsp": false,
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1",
        "apiKey": "sk-b59c45c1d2df4f948e6537b822359fa5",
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": { "context": 100000, "output": 384000 }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": { "context": 100000, "output": 384000 }
        }
      }
    }
  },
  "agent": {
    "explore": {
      "disable": true
    }
  },
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server"
      ],
      "enabled": true
    },
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true, 
    },
  },
  "permission": {
    "*": "ask",
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "open-plan-annotator@latest",
    "opencode-snip@latest",
    "openslimedit@latest",
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "keep": {
      "tokens": 2000
    },
    "buffer": 10000
  },
  "experimental": {
    "mcp_timeout": 60000
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 16384
  }
}
